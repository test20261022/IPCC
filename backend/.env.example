# ===== 应用 =====
APP_NAME=企业管理平台
APP_VERSION=0.1.0
DEBUG=true
API_V1_PREFIX=/api/v1

# ===== 认证（生产环境必须替换 SECRET_KEY）=====
SECRET_KEY=change-me-to-a-random-secret-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# bcrypt 成本因子：生产保持 12，测试环境可下调以加快用例
BCRYPT_ROUNDS=12

# ===== 数据库（PostgreSQL，时间统一 UTC / timestamptz）=====
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app
TEST_DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app_test
DB_ECHO=false

# ===== Redis：留空则自动降级（登出黑名单不生效，仅记录日志）=====
REDIS_URL=redis://localhost:6379/0

# ===== CORS，多个来源用英文逗号分隔 =====
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== 分页 =====
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=200

# ===== 外部系统 Provider（§68：全部走配置，禁止硬编码）=====
# 可选值：mock / third_party（phone）| mock / gateway（call）| mock
CALL_GATEWAY_PROVIDER=mock
CALL_GATEWAY_URL=
CALL_GATEWAY_API_KEY=
# 呼叫网关回写结果的签名密钥；留空表示未配置，回调接口一律拒绝
CALL_GATEWAY_CALLBACK_SECRET=
# 回调签名时间戳容差（秒），超出容差视为重放攻击
CALL_GATEWAY_CALLBACK_TOLERANCE_SECONDS=300

PHONE_PROVIDER=mock
PHONE_PROVIDER_URL=
PHONE_PROVIDER_API_KEY=

IVR_PROVIDER=mock
ASR_PROVIDER=mock
# ASR（语音转文字）：mock（固定假数据）/ aliyun（模拟阿里云，演示用，不发真实请求）
# 服务地址与密钥；ASR_PROVIDER=mock 时留空即可
ASR_PROVIDER_URL=
ASR_PROVIDER_API_KEY=
TTS_PROVIDER=mock

PROVIDER_TIMEOUT_SECONDS=10
PROVIDER_MAX_RETRIES=2
MOCK_CALL_CONNECT_DURATION=30

# ===== 定时任务（超时回收 / 重试派发 / 预占超时释放 / 回呼派单）=====
SCHEDULER_ENABLED=true
TIMEOUT_RECYCLE_INTERVAL_SECONDS=30
RETRY_DISPATCH_INTERVAL_SECONDS=60
EXECUTE_BATCH_SIZE=20

# ===== 回呼（到期派单）=====
CALLBACK_DISPATCH_INTERVAL_SECONDS=60
CALLBACK_DISPATCH_BATCH_SIZE=50

# ===== 坐席分配（§35 预占）=====
RESERVATION_TIMEOUT_SECONDS=60
RESERVATION_EXPIRE_INTERVAL_SECONDS=30

# ===== 对话质检（QC）=====
# 单任务下每位专家的明细上限，超过则拒绝派发并提示拆批
QC_MAX_PER_REVIEWER=20000
# 专家组成员默认单轮质检量
QC_DEFAULT_QUOTA_PER_REVIEWER=50
# 派发分批提交的批大小（避免 10 万行单事务长时间持锁）
QC_DISPATCH_BATCH_SIZE=2000
# 明细领取锁定超时（秒）与超时回收扫描间隔（秒）
QC_ITEM_LOCK_TIMEOUT_SECONDS=1800
QC_ITEM_RECYCLE_INTERVAL_SECONDS=300
# 质检报表按天分桶使用的时区（reviewed_at 存 UTC，必须显式换算）
QC_REPORT_TIMEZONE=Asia/Shanghai
# 评级阈值：优秀 / 及格 的下界（百分制）
QC_GRADE_EXCELLENT_MIN=90
QC_GRADE_PASS_MIN=60
# 单次对话导入的最大条数与失败明细保留上限
QC_IMPORT_MAX_ROWS=100000
QC_IMPORT_MAX_FAILURE_DETAIL=500

# ===== 初始超级管理员（首次执行 scripts/init_db.py 时创建）=====
FIRST_SUPERUSER=admin
FIRST_SUPERUSER_PASSWORD=change-me
FIRST_SUPERUSER_NICKNAME=系统管理员
